{
  "manifest_version": 3,
  "name": "SIN Email Marketing Management",
  "version": "0.1.1",
  "description": "Create personalized sales emails with OpenAI and prepare them in Private Email.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://privateemail.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open SIN Email Marketing Management" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{
    "matches": ["https://privateemail.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
